# Admin login password for /admin
ADMIN_PASSWORD=change-me
# Random string, 32+ characters, used to sign the admin session cookie
NUXT_SESSION_SECRET=replace-with-a-long-random-string-of-32-chars-min
# Free persistent database: Upstash Redis (Vercel Marketplace -> Upstash, free tier).
# Vercel injects KV_REST_API_URL / KV_REST_API_TOKEN automatically when connected.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Only for the mobile build: the deployed site URL, e.g. https://orbit-studio.vercel.app
NUXT_PUBLIC_API_BASE=
